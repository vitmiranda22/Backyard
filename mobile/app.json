{
  "expo": {
    "name": "Backyard",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "backyard",
    "orientation": "portrait",
    "icon": "./assets/bosco-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vitorsm9004.backyard",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Backyard uses your microphone so you can ask spoken questions about where you're standing.",
        "NSLocationWhenInUseUsageDescription": "Backyard uses your location to narrate the block you're standing on and guide you toward nearby points of interest during a tour."
      }
    },
    "android": {
      "package": "com.vitorsm9004.backyard",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@sentry/react-native/expo",
      [
        "expo-splash-screen",
        {
          "image": "./assets/bosco-icon.png",
          "imageWidth": 1200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Backyard uses your location to narrate the block you're standing on and guide you toward nearby points of interest during a tour."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Backyard uses your photo library so you can pick a photo to remember this walk by.",
          "cameraPermission": "Backyard uses your camera so you can take a photo to remember this walk by."
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.187668922138-qku980bkulpne0275jon6agbdevnqlsk"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "34c0f2cf-1928-4ade-bc2d-1415860a1487"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/34c0f2cf-1928-4ade-bc2d-1415860a1487"
    }
  }
}
